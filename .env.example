AZURE_SUBSCRIPTION_ID=<tu-subscription-id>
AZURE_RESOURCE_GROUP=rg-actividad-db
AZURE_LOCATION=eastus
AZURE_PG_LOCATION=centralus
AZURE_PG_SERVER=<servidor>.postgres.database.azure.com
AZURE_PG_DATABASE=db_actividad_mineria
AZURE_PG_PORT=5432

# 1. Administrador (SOLO uso local para subir esquema, CSV y Excel)
DATABASE_URL=postgresql://pgadmin_uk:<ADMIN_PASSWORD>@<servidor>.postgres.database.azure.com:5432/db_actividad_mineria?sslmode=require

# 2. Enlace unico compartible de SOLO LECTURA (rol lector_uk)
DATABASE_URL_READONLY=postgresql://lector_uk:<READONLY_PASSWORD>@<servidor>.postgres.database.azure.com:5432/db_actividad_mineria?sslmode=require

# 3. Conexion para motor de predicciones / futura API (rol app_predicciones)
DATABASE_URL_APP=postgresql://app_predicciones:<APP_PASSWORD>@<servidor>.postgres.database.azure.com:5432/db_actividad_mineria?sslmode=require
