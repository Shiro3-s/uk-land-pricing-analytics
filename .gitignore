# Entorno / dependencias (no se suben librerías)
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# Referencias locales (no se suben)
contexto/

# Documento del avance y su generador (solo se sube el PDF; el docx no)
*.docx
script/documentacion/

# Datos grandes locales: solo se sube una muestra (sufijo _muestra) de cada archivo
db/*
!db/*_muestra.csv
data/limpia/*
!data/limpia/*_muestra.csv
!data/limpia/*_muestra.parquet
data/integrado/*.parquet
!data/integrado/*_muestra.parquet
.agents/*

# Windows
Thumbs.db
Desktop.ini
