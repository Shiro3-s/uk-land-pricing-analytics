     "iopub.execute_input": "2026-10-19T01:47:53.798009Z",
     "iopub.status.busy": "2026-10-19T01:47:53.797823Z",
     "iopub.status.idle": "2026-10-19T01:47:57.768066Z",
     "shell.execute_reply": "2026-10-19T01:47:57.766929Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
